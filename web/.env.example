# Upstash Redis (shared leaderboard). Add the "Upstash Redis" integration from the
# Vercel Marketplace (Storage tab) and it injects these on deploy — as either the
# UPSTASH_REDIS_REST_* names OR Vercel's KV_REST_API_* names. The app reads either.
# Pull locally with `vercel env pull .env.local`. If unset, it falls back to an
# in-memory store (per-process, resets on restart) — fine for local dev, NOT shared.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel-KV / Marketplace equivalents (either pair works):
KV_REST_API_URL=
KV_REST_API_TOKEN=
