# Sovereign Shield — the core library needs NO keys (detection is offline + deterministic).
# The keys below are only for the optional gateway proxy, the live demo, and corpus regen.

# --- Gateway proxy (optional [gateway] extra: sovereign_shield.gateway with Gemini) ---
GOOGLE_API_KEY=

# --- Demo (web/) shared "kept in Switzerland" counter — Upstash Redis ---
# Vercel's Upstash integration injects either pair; the app reads whichever is set.
# Unset -> in-memory fallback (per-process, resets on restart). See web/.env.example.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Regenerating the demo corpus (scripts/gen_gateway_corpus.py) ---
# Only for re-recording model responses; needs a key per provider you record.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
